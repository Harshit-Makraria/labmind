generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── NextAuth models ─────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("student") // "instructor" | "student"
  accounts      Account[]
  sessions      Session[]
  labSessions   LabSession[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ─── Lab models ───────────────────────────────────────────────────────

model LabSession {
  id               String              @id
  studentName      String              @default("Student")
  experimentId     String
  experimentName   String
  currentStep      Int                 @default(1)
  totalSteps       Int
  status           String              @default("active")
  reagentHistory   Json                @default("[]")
  lastVisionPass   Boolean?
  deviationPercent Float?
  /// The student's own final measured value (e.g. mean titre, absorbance
  /// reading) — kept alongside deviationPercent so the learning summary can
  /// compare the student's PRE-lab hypothesis against what they actually
  /// measured, not just against the textbook theoretical value.
  studentResult    Float?
  safetyAlertCount Int                 @default(0)
  duplicatePhotoCount Int              @default(0)
  steps            Json                @default("[]")
  safetyLog        Json                @default("[]")
  notes            Json                @default("[]")
  hypothesis       String?
  prelabScore      Float?
  prelabPassed     Boolean?
  /// A student-initiated skip request awaiting instructor approval. Only
  /// meaningful when instructorCode is set — solo/library sessions skip
  /// instantly with no request cycle. Cleared on approval, deny, or once
  /// SKIP_REQUEST_TIMEOUT_MS has elapsed unanswered.
  skipRequestStep  Int?
  skipRequestAt    DateTime?
  instructorCode   String?
  instructor       InstructorSession?  @relation(fields: [instructorCode], references: [code])
  verifications    VerificationEntry[]
  userId           String?
  user             User?               @relation(fields: [userId], references: [id])
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([instructorCode])
  @@index([userId])
  @@index([experimentId])
}

/// Append-only tamper-evident safety log. Rows are only ever INSERTed by
/// appendAuditEntry() — there is no update/delete path anywhere in the app.
/// Each row's hash is fixed at write time from the row's own content plus the
/// PREVIOUS row's hash, so verifyChain() can detect any edit made to a row
/// after the fact (e.g. a direct DB edit) by recomputing the hash from
/// current content and finding it no longer matches the hash stored here.
model AuditLogEntry {
  id         Int      @id @default(autoincrement())
  sessionId  String
  stepNumber Int
  summary    String
  severity   String
  prevHash   String
  hash       String
  at         DateTime @default(now())

  @@index([sessionId])
}

model InstructorSession {
  code            String       @id
  sessionName     String
  experimentId    String
  experimentName  String
  batch           String       @default("")
  department      String       @default("")
  institution     String       @default("")
  courseCode      String       @default("")
  date            String
  status          String       @default("active")
  notes           Json         @default("{}")
  /// Full AI-parsed protocol (experiment_name + steps) when the instructor
  /// uploaded their own experiment PDF at session-creation time. Null means
  /// "use the library protocol for experimentId" — the previous behavior,
  /// and still what a student joining gets when this is unset. When set,
  /// every student who joins this code gets THIS protocol instead, so the
  /// AI parse happens once (at creation) rather than being silently
  /// discarded after only its experiment_name was kept.
  customProtocol  Json?
  students        LabSession[]
  /// Owning instructor account. Nullable so pre-existing rows (seeded demo
  /// data, sessions created before this column existed) don't break — those
  /// are treated as ownerless/shared rather than retroactively assigned.
  createdByUserId String?
  createdAt       DateTime     @default(now())

  @@index([createdByUserId])
}

model VerificationEntry {
  id                String     @id @default(cuid())
  sessionId         String
  session           LabSession @relation(fields: [sessionId], references: [id])
  studentName       String
  stepNumber        Int
  imageBase64       String     @db.Text
  /// Perceptual dHash — detects the same photo resubmitted for another step.
  imageHash         String?
  aiReading         Float?
  aiConfidence      Float
  aiMessage         String?
  status            String     @default("pending")
  instructorComment String?
  submittedAt       DateTime   @default(now())
  resolvedAt        DateTime?

  @@index([sessionId])
  @@index([status])
}

model AgentDecision {
  id        String   @id @default(cuid())
  sessionId String
  trigger   String
  plan      String   @db.Text
  tools     Json     @default("[]")
  outcome   String   @db.Text
  provider  String
  latencyMs Int
  createdAt DateTime @default(now())
}

model AppSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model TraceSpan {
  id            String   @id @default(cuid())
  toolName      String
  inputSummary  String
  outputSummary String
  latencyMs     Int
  confidence    Float?
  createdAt     DateTime @default(now())
}
