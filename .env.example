# ─── Database (required) ────────────────────────────────────────────────────
# Postgres — Supabase works well. DIRECT_URL bypasses the pooler for migrations.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# ─── Auth (required — NextAuth v5) ──────────────────────────────────────────
# Generate a secret with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-random-secret
AUTH_URL=http://localhost:3000

# ─── LLM Provider (provider-agnostic, read server-side by the Route Handlers) ──
# LLM_PROVIDER selects the active adapter: "demo" | "auto" | "openai" | "gemini" | "claude"
# "demo" needs NO API key and returns deterministic, realistic (and genuinely
# fallible) responses — perfect for a zero-config run and for the jury.
# "auto" (the default) uses a DIFFERENT preferred provider per capability:
#   - Chat/text: OpenAI first, then Gemini, then Claude.
#   - Vision (photo verification): Gemini first, then OpenAI, then Claude.
# Claude is available on both but only used when explicitly selected
# ("claude" below, or "Claude only" in Settings) — falls back to demo mode
# if no key from the relevant order is actually set.
LLM_PROVIDER=auto

# Master demo switch — when true, every AI tool returns deterministic data
# regardless of provider, and the DEMO MODE badge shows in the corner.
DEMO_MODE=true

# Instructor dashboard passcode (legacy — real auth is via signup/login above).
INSTRUCTOR_PASSCODE=labmind2026

# ─── Optional: real LLM providers (only used when DEMO_MODE=false) ─────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Vision (photo verification) always uses a SEPARATE, stronger model than the
# plain-text one above — reading a burette/gel/absorbance photo correctly is
# the single highest-value accuracy lever in this app.
OPENAI_VISION_MODEL=gpt-4o

GEMINI_API_KEY=...
GEMINI_MODEL=gemini-1.5-flash
# Gemini is the default vision provider, so it gets its own model setting too.
GEMINI_VISION_MODEL=gemini-1.5-flash

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# Same idea as OPENAI_VISION_MODEL above — this is the model that actually
# reads student photos, kept independent of ANTHROPIC_MODEL.
ANTHROPIC_VISION_MODEL=claude-sonnet-5

# Provider keys AND the specific model per provider/capability can also be
# set from the Settings page in the app (stored server-side) — the Settings
# picker fetches each provider's live model list so you're never stuck on a
# model ID that's since been deprecated. The env vars above are only the
# defaults used until something is picked there.

# NOTE: There is NO separate backend URL to configure. The API ships inside
# this Next.js app as Route Handlers (/api/*), so it is same-origin on Vercel.
